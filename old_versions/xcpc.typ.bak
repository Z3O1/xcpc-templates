= 字符串

== Manacher

```cpp
int n, d[N << 1];
char st[N], s[N << 1];
void manacher() {
    int l = 0, r = -1;
    For(i, 1, n) {
        int &k = d[i];
        k = i > r ? 1 : min(d[l + r - i], r - i + 1);
        while (s[i - k] == s[i + k]) k++;
        if (i + k - 1 > r) r = i + k - 1, l = i - k + 1;
    }
}
```

== Z 函数

```cpp
void zfunc(int n, const int *const s, int *const z) {
    fill(z + 1, z + n + 1, 0), z[1] = n;
    int l = 0;
    For(i, 2, n) {
        if (z[l] + l - 1 >= i) z[i] = min(z[i - l + 1], l + z[l] - i);
        while (s[z[i] + 1] == s[i + z[i]]) z[i]++;
        if (i + z[i] > l + z[l]) l = i;
    }
}
```

== 最小表示法

```cpp
template <typename T>
int getmin(const vect<T> &a) {
    int n = a.size(), i = 0, j = 1, k = 0;
    while(i < n && j < n && k < n) {
        if(a[(i + k) % n] == a[(j + k) % n]) {
            ++k;
        } else {
            if(a[(i + k) % n] > a[(j + k) % n]) swap(i, j);
            j += k + 1, j += i == j, k = 0;
        }
    }
    return i;
}
```

== SAM

```cpp
int lst = 1, tot = 1, t[N][26], f[N], l[N], cnt[N];
void ins(int x) {
    int c = ++tot, p = exchange(lst, c);
    l[c] = l[p] + 1, cnt[c] = 1;
    while (p && !t[p][x]) t[p][x] = c, p = f[p];
    if (!p) return f[c] = 1, void();
    int q = t[p][x];
    if (l[p] + 1 == l[q]) {
        f[c] = q;
    } else {
        int o = ++tot;
        memcpy(t[o], t[q], sizeof(t[o]));
        f[o] = f[q], f[q] = f[c] = o, l[o] = l[p] + 1;
        while (p && t[p][x] == q) t[p][x] = o, p = f[p];
    }
}
```

== SA

```cpp
const int N = 1e6 + 10;
int sa[N], rk[N << 1], st[20][N];
void SA(int n, auto *a) {
    static int b[N], c[N];
    int m = *max_element(a + 1, a + n + 1);
    For(i, 1, n) b[i] = i, rk[i] = a[i];
    For(i, n + 1, n * 2) rk[i] = 0;
    auto bs = [&]() {
        memset(c, 0, m + 1 << 2);
        For(i, 1, n)++ c[rk[i]];
        For(i, 1, m) c[i] += c[i - 1];
        rFor(i, n, 1) sa[c[rk[b[i]]]--] = b[i];
    };
    bs();
    for (int t = 1; t < n; t += t) {
        int tot = 0;
        For(i, n - t + 1, n) b[++tot] = i;
        For(i, 1, n) if (sa[i] > t) b[++tot] = sa[i] - t;
        bs();
        b[sa[1]] = m = 1;
        For(i, 2, n) {
            int x = sa[i], y = sa[i - 1];
            b[x] = m += (rk[x] != rk[y] || rk[x + t] != rk[y + t]);
        }
        memcpy(rk, b, n + 1 << 2);
        if (m == n) break;
    }
    int k = 0;
    a[n + 1] = -1;
    For(i, 1, n) {
        k -= k > 0;
        while (a[i + k] == a[sa[rk[i] - 1] + k]) ++k;
        st[0][rk[i]] = k;
    }
    For(i, 1, __lg(n)) For(j, 1, n - (1 << i) + 1) {
        st[i][j] = min(st[i - 1][j], st[i - 1][j + (1 << i - 1)]);
    }
}
int lcp(int x, int y) {
    x = rk[x], y = rk[y];
    if (x > y) swap(x, y);
    int k = __lg(y - x);
    return min(st[k][x + 1], st[k][y - (1 << k) + 1]);
}
```

