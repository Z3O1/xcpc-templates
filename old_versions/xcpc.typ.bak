```cpp
int rd() {
    static char buf[50000000], *p = 0;
    if(!p) fread(buf, sizeof(buf), 1, stdin), p = buf;
    int x = 0;
    for(; !isdigit(*p);) ++p;
    for(; isdigit(*p); ++p) x = x * 10 + ((*p) & 15);
    return x;
}
