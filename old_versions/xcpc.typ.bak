        if(!t[l][a[i]]) {
            t[l][a[i]] = ++tot;
            len[tot] = len[l] + 2;
            fa[tot] = !l ? 1 : t[get(fa[l])][a[i]];
        }
        l = t[l][a[i]];
    }
}
